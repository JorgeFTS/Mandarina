#!/usr/bin/env bash
# Nautilus script: right-click > Scripts > Convert with Mandarina (or the name in your language)
# The installer copies it under the name of the active language.

# Nautilus passes the selected items separated by newlines; all of them are kept,
# each one as an argument (so spaces and quotes in the names are preserved)
files=()
if [ -n "$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS" ]; then
    while IFS= read -r line; do
        if [ -n "$line" ]; then
            files+=("$line")
        fi
    done <<< "$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS"
else
    files=("$@")
fi
if [ "${#files[@]}" -eq 0 ]; then
    exit 0
fi

# Search order for the program: the MANDARINA_BIN variable, PATH and, last,
# the path that the installer writes in place of the marker
if [ -n "$MANDARINA_BIN" ]; then
    bin="$MANDARINA_BIN"
elif command -v mandarina >/dev/null 2>&1; then
    bin="mandarina"
else
    bin="__MANDARINA_BIN__"
fi

# Transparent window: better with X11 (on Wayland it cannot be placed next to the cursor)
export GDK_BACKEND=x11
exec "$bin" "${files[@]}"
