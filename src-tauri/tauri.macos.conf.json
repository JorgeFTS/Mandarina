          "srt",
          "vtt"
        ],
        "contentTypes": [
          "org.w3.webvtt"
        ],
        "name": "Subtitles",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "zip",
          "tar",
          "gz",
          "tgz",
          "rar"
        ],
        "contentTypes": [
          "public.zip-archive",
          "public.tar-archive",
          "org.gnu.gnu-zip-archive",
          "org.gnu.gnu-zip-tar-archive",
          "com.rarlab.rar-archive"
