      {
        "ext": [
          "avif",
          "flac",
          "ogg",
          "opus",
          "aif",
          "aiff",
          "wma",
          "webm",
          "wmv",
          "docx",
          "doc",
          "odt",
          "md",
          "epub",
          "pptx",
          "ppt",
          "odp",
          "xlsx",
          "xls",
          "ods",
          "csv",
          "tsv",
          "srt",
          "vtt",
          "zip",
          "tar",
          "gz",
          "tgz",
          "rar"
        ],
        "name": "Other files",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
