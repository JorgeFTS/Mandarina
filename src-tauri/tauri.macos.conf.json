{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg",
          "png",
          "webp",
          "heic",
          "heif",
          "tif",
          "tiff",
          "avif",
          "bmp",
          "gif",
          "svg"
        ],
        "name": "Image",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "mp3",
          "m4a",
          "wav",
          "flac",
          "ogg",
          "opus",
          "aif",
          "aiff",
          "wma"
        ],
        "name": "Audio",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "mp4",
          "mov",
          "mkv",
          "webm",
          "avi",
          "wmv"
