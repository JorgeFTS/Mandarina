{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg",
          "png",
          "webp",
          "heic",
          "heif",
          "tif",
          "tiff",
          "avif",
          "bmp",
          "gif",
          "svg"
        ],
        "contentTypes": [
          "public.jpeg",
          "public.png",
          "org.webmproject.webp",
          "public.heic",
          "public.heif-standard-image",
          "public.heif",
          "public.tiff",
          "public.avif",
          "com.microsoft.bmp",
          "com.compuserve.gif",
          "public.svg-image"
        ],
        "name": "Image",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "mp3",
          "m4a",
          "wav",
          "flac",
          "ogg",
          "opus",
          "aif",
          "aiff",
          "wma"
        ],
        "contentTypes": [
          "public.mp3",
          "com.apple.m4a-audio",
          "public.mpeg-4-audio",
          "com.microsoft.waveform-audio",
          "org.xiph.flac",
          "org.xiph.ogg-audio",
          "org.xiph.opus",
          "public.aiff-audio",
          "com.microsoft.windows-media-wma"
        ],
        "name": "Audio",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "mp4",
          "mov",
          "mkv",
          "webm",
          "avi",
          "wmv"
        ],
        "contentTypes": [
          "public.mpeg-4",
          "com.apple.quicktime-movie",
          "org.matroska.mkv",
          "org.webmproject.webm",
          "public.avi",
          "com.microsoft.windows-media-wmv"
        ],
        "name": "Video",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "pdf"
        ],
        "contentTypes": [
          "com.adobe.pdf"
        ],
        "name": "PDF",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "docx",
          "doc",
          "odt",
          "rtf",
          "md",
          "txt",
          "epub",
          "html",
          "htm"
        ],
        "contentTypes": [
          "org.openxmlformats.wordprocessingml.document",
          "com.microsoft.word.doc",
          "org.oasis-open.opendocument.text",
          "public.rtf",
          "net.daringfireball.markdown",
          "public.plain-text",
          "org.idpf.epub-container",
          "public.html"
        ],
        "name": "Document",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "pptx",
          "ppt",
          "odp"
        ],
        "contentTypes": [
          "org.openxmlformats.presentationml.presentation",
          "com.microsoft.powerpoint.ppt",
          "org.oasis-open.opendocument.presentation"
        ],
        "name": "Presentation",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "xlsx",
          "xls",
          "ods",
          "csv",
          "tsv"
