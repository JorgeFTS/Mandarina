{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mandarina",
  "version": "0.1.0",
  "identifier": "com.mandarina.converter",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mandarina",
        "width": 460,
        "height": 460,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "File converter with a floating radial wheel",
    "longDescription": "Mandarina converts files locally (images, audio, video, documents, PDF, spreadsheets, subtitles and archives) from a radial wheel that appears next to the cursor, and offers tools such as compress, trim, rotate and resize. It uses ffmpeg, ImageMagick, pandoc, LibreOffice, poppler and ghostscript.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "recommends": [
          "ffmpeg",
          "imagemagick",
          "librsvg2-bin",
          "pandoc",
          "libreoffice",
          "poppler-utils",
          "ghostscript",
          "zip",
          "unzip",
          "p7zip-full"
        ]
      }
    }
  }
}
